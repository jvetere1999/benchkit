#!/bin/sh
# This repo works on main only (see .githooks/README.md): refuse to create any other branch.
# Runs on both macOS and Windows (Git for Windows runs hooks with its own sh).
[ "$1" = "prepared" ] || exit 0
while read -r old new ref; do
  case "$ref" in
    refs/heads/main) ;;
    refs/heads/*)
      if [ -z "$(printf '%s' "$old" | tr -d 0)" ]; then   # old is all zeros: a new branch
        echo "This repo works on main only, so new branches are turned off (${ref#refs/heads/})." >&2
        echo "Commit on main instead: git switch main" >&2
        exit 1
      fi ;;
  esac
done
exit 0
